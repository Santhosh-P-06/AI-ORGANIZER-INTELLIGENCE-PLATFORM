# GEMINI_API_KEY: Optional. Enables live Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string used by the Node.js API layer.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_event_organiser"

# APP_URL/NEXT_PUBLIC_APP_URL: Used for n8n callbacks, certificate links, and the Flutter client.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# N8N_BASE_URL: Your n8n Cloud instance URL.
N8N_BASE_URL="https://santhoshp.app.n8n.cloud"

# N8N_WEBHOOK_SECRET: Shared secret n8n sends as the x-n8n-secret header.
N8N_WEBHOOK_SECRET="change_me"

# N8N_REGISTRATION_WEBHOOK_URL: Webhook URL for n8n registration confirmation workflow
N8N_REGISTRATION_WEBHOOK_URL="https://santhoshp.app.n8n.cloud/webhook/registration-confirmation"

# N8N_PANEL_ALLOCATION_WEBHOOK_URL: Webhook URL for n8n panel allocation workflow
N8N_PANEL_ALLOCATION_WEBHOOK_URL="https://santhoshp.app.n8n.cloud/webhook/panel-allocation"
